# Copy to .env and fill in values.
OPENAI_API_KEY=
MODEL_STRONG=openai:gpt-5.5
# verify available model name
MODEL_LIGHT=openai:gpt-5.5-mini

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=shipwright

MONGODB_URI=
MONGODB_DB=shipwright

PINECONE_API_KEY=
PINECONE_INDEX=shipwright-knowledge
PINECONE_NAMESPACE=taskboard-api

LLAMA_CLOUD_API_KEY=
TAVILY_API_KEY=

GITHUB_PAT=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# format: owner/name
SHIPWRIGHT_REPO=

JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT=SHIP

# langsmith | local
SHIPWRIGHT_SANDBOX_PROVIDER=langsmith
MAX_TEST_ATTEMPTS=3
MAX_REVIEW_CYCLES=2
ORCHESTRATOR_MODEL_CALL_LIMIT=150
SANDBOX_IDLE_TTL_SECONDS=3600
ORG_ID=default-org
